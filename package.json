{
  "name": "fu-developers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official multi-page website of FU DEVELOPERS — digital development agency",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build && vite build --ssr scripts/ssr-entry.tsx --outDir .ssr-build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "ssr-check": "node scripts/ssr-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
